erDiagram
    Repository {
        uuid id PK
        uuid tenant_id FK
        uuid integration_id FK
        bigint external_id
        text full_name
        text state
        bigint access_epoch
    }
    MergeRequest {
        uuid id PK
        uuid tenant_id FK
        uuid repository_id FK
        bigint external_number
        jsonb revision_descriptor
        bigint revision_epoch
    }
    RepositoryIndex {
        uuid id PK
        uuid tenant_id FK
        uuid repository_id FK
        text commit_oid
        text config_hash
        text state
    }
    ReviewRequest {
        uuid id PK
        uuid tenant_id FK
        uuid merge_request_id FK
        uuid actor_membership_id FK
        uuid actor_service_id FK
        text config_hash
        text state
    }
    ReviewJob {
        uuid id PK
        uuid tenant_id FK
        uuid request_id FK
        uuid merge_request_id FK
        uuid index_id FK
        bigint revision_epoch
        text state
    }
    ReviewProfile {
        uuid id PK
        uuid tenant_id FK
        text name
        boolean is_default
        jsonb settings
    }
    ProfilePerspective {
        uuid tenant_id PK
        uuid profile_id PK
        uuid perspective_id PK
        integer position
    }
    Perspective {
        uuid id PK
        uuid tenant_id FK
        text key
        text name
        text state
    }
    PromptVersion {
        uuid id PK
        uuid tenant_id FK
        uuid perspective_id FK
        integer version
        text instructions
        jsonb settings
        text content_hash
    }
    PerspectiveRun {
        uuid id PK
        uuid tenant_id FK
        uuid job_id FK
        uuid perspective_id FK
        uuid prompt_version_id FK
        text state
        jsonb coverage
    }
    Repository ||--o{ MergeRequest : "repository_id"
    Repository ||--o{ RepositoryIndex : "repository_id"
    MergeRequest ||--o{ ReviewRequest : "merge_request_id"
    ReviewRequest ||--o{ ReviewJob : "request_id"
    RepositoryIndex o|--o{ ReviewJob : "index_id"
    ReviewProfile ||--o{ ProfilePerspective : "profile_id"
    Perspective ||--o{ ProfilePerspective : "perspective_id"
    Perspective ||--o{ PromptVersion : "perspective_id"
    ReviewJob ||--o{ PerspectiveRun : "job_id"
    PromptVersion ||--o{ PerspectiveRun : "prompt_version_id"
