erDiagram
    ReviewJob {
        uuid id PK
        uuid tenant_id FK
        uuid request_id FK
        uuid merge_request_id FK
        uuid index_id FK
        bigint revision_epoch
        text state
    }
    PerspectiveRun {
        uuid id PK
        uuid tenant_id FK
        uuid job_id FK
        uuid perspective_id FK
        uuid prompt_version_id FK
        text state
        jsonb coverage
    }
    ModelCall {
        uuid id PK
        uuid tenant_id FK
        uuid job_id FK
        uuid perspective_run_id FK
        text kind
        uuid accepted_attempt_id FK
    }
    ContextPayload {
        uuid id PK
        uuid tenant_id FK
        uuid model_call_id FK
        jsonb request_body
        text content_hash
        bigint token_count
        bigint output_reserve
    }
    InferenceAttempt {
        uuid id PK
        uuid tenant_id FK
        uuid model_call_id FK
        uuid work_item_id FK
        integer attempt_no
        uuid owner_token
        text state
    }
    Finding {
        uuid id PK
        uuid tenant_id FK
        uuid job_id FK
        uuid model_call_id FK
        uuid attempt_id FK
        uuid duplicate_of_id FK
    }
    Comment {
        uuid id PK
        uuid tenant_id FK
        uuid job_id FK
        uuid finding_id FK
        text publication_key
        text state
        text provider_comment_id
    }
    WorkItem {
        uuid id PK
        uuid tenant_id FK
        text kind
        text business_key
        text state
        uuid lease_token
        timestamptz locked_until
    }
    WebhookInbox {
        uuid id PK
        text provider_scope
        text delivery_id
        uuid tenant_id FK
        text payload_hash
        jsonb payload
        text state
    }
    ReviewJob ||--o{ PerspectiveRun : "job_id"
    ReviewJob ||--o{ ModelCall : "job_id"
    PerspectiveRun o|--o{ ModelCall : "perspective_run_id"
    ModelCall ||--o| ContextPayload : "model_call_id"
    ModelCall ||--o{ InferenceAttempt : "model_call_id"
    WorkItem ||--o{ InferenceAttempt : "work_item_id"
    InferenceAttempt ||--o{ Finding : "attempt_id"
    Finding o|--o{ Comment : "finding_id"
    ReviewJob ||--o{ Comment : "job_id"
