erDiagram
    user {
        uuid id PK "NOT NULL"
        text state "NOT NULL"
        text display_name "NOT NULL"
        timestamptz created_at "NOT NULL"
    }
    external_identity {
        uuid id PK "NOT NULL"
        uuid user_id FK "NOT NULL"
        text provider_host "NOT NULL"
        bigint external_user_id "NOT NULL"
        text user_grant_ref "NULL"
        timestamptz access_checked_at "NULL"
    }
    auth_session {
        uuid id PK "NOT NULL"
        uuid user_id FK "NOT NULL"
        text token_hash "NOT NULL"
        timestamptz expires_at "NOT NULL"
        timestamptz revoked_at "NULL"
    }
    workspace {
        uuid id PK "NOT NULL"
        text name "NOT NULL"
        text state "NOT NULL"
        bigint access_epoch "NOT NULL"
    }
    membership {
        uuid id PK "NOT NULL"
        uuid tenant_id FK "NOT NULL"
        uuid user_id FK "NOT NULL"
        text role "NOT NULL"
        text state "NOT NULL"
        bigint access_epoch "NOT NULL"
    }
    workspace_invitation {
        uuid id PK "NOT NULL"
        uuid tenant_id FK "NOT NULL"
        uuid invited_by_id FK "NOT NULL"
        bigint expected_github_user_id "NOT NULL"
        text role "NOT NULL"
        text token_hash "NOT NULL"
        timestamptz expires_at "NOT NULL"
        uuid accepted_membership_id FK "NULL"
        text state "NOT NULL"
    }
    service_account {
        uuid id PK "NOT NULL"
        uuid tenant_id FK "NOT NULL"
        text name "NOT NULL"
        text state "NOT NULL"
        bigint access_epoch "NOT NULL"
        uuid authorized_by_id FK "NOT NULL"
    }
    user ||--o{ external_identity : "user_id"
    user ||--o{ auth_session : "user_id"
    workspace ||--o{ membership : "tenant_id"
    user ||--o{ membership : "user_id"
    membership o|--o{ workspace_invitation : "tenant_id,accepted_membership_id"
    membership ||--o{ workspace_invitation : "tenant_id,invited_by_id"
    workspace ||--o{ workspace_invitation : "tenant_id"
    membership ||--o{ service_account : "tenant_id,authorized_by_id"
    workspace ||--o{ service_account : "tenant_id"
